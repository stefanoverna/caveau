{
  "name": "kavo",
  "version": "0.2.19",
  "description": "Easy file repository encryption tool based on age, focused on simplicity and gitops",
  "main": "index.js",
  "type": "module",
  "bin": "bin/kavo.mjs",
  "scripts": {
    "test": "npm run build && node --test",
    "build": "rimraf dist && tsc-multi",
    "prepare": "npx simple-git-hooks && npm run build",
    "format": "biome check --write --unsafe .",
    "changeset": "changeset",
    "release": "release-toolchain",
    "release:next": "release-toolchain --tag next",
    "prepublishOnly": "release-toolchain --assert-release"
  },
  "files": [
    "bin",
    "dist",
    "schemas"
  ],
  "author": "Stefano Verna <s.verna@datocms.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "age-encryption": "^0.3.1",
    "cmd-ts": "^0.15.0",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "ignore": "^7.0.9",
    "lodash-es": "^4.18.1",
    "open-editor": "^6.0.0",
    "prompt-sync": "^4.2.0",
    "tempy": "^3.2.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.3",
    "@datocms/release-toolchain": "github:datocms/release-toolchain#v1.2.0",
    "@types/node": "^22.20.2",
    "@types/prompt-sync": "^4.2.3",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "tsc-multi": "^1.1.0",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanoverna/caveau.git"
  }
}
